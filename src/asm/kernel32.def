; ENGLISH-ELF kernel32 import library definition
; Generate build\kernel32.lib with:
;   lld-link /def:src\asm\kernel32.def /out:build\kernel32.lib /machine:x64 /nodefaultlib

LIBRARY kernel32
EXPORTS
    CloseHandle
    CreateFileA
    ExitProcess
    GetCommandLineA
    GetFileSizeEx
    GetLastError
    GetStdHandle
    ReadFile
    Sleep
    VirtualAlloc
    WriteFile
